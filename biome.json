{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [{ "type": true }]
          }
        },
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "includes": ["src/**/*", "!src/generated/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/lambda/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/lambda/**"],
                    "message": "Frontend and shared code must not import from src/lambda. Move the shared code to src/lib or src/types instead; see src/lib/README.md."
                  },
                  {
                    "group": ["@aws-sdk/**"],
                    "message": "Frontend and shared code must not depend on the AWS SDK. Mirror the needed shape in src/types instead (see EmailTemplateContent in src/types/Email.ts)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**", "src/i18n/**", "src/rules.ts", "src/rules_ch.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/lambda/**"],
                    "message": "Shared code must not import from src/lambda. Move the shared code to src/lib or src/types instead; see src/lib/README.md."
                  }
                ],
                "paths": {
                  "date-fns": {
                    "allowImportNames": ["Locale"],
                    "message": "Import date-fns by module path instead: date-fns/addDays. A bare specifier pulls the whole 245-export index into the module graph; when the lambdas resolved it from the dependencies layer that cost 508 ms of cold start against 8 ms for one module (KOE-6). Bundling (KOE-1330) now tree-shakes it away for the lambdas, but the module path stays the convention -- the frontend build has not been measured."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lambda/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/pages/**", "**/hooks/**", "../api/**", "../../api/**", "../../../api/**", "**/lib/client/**"],
                    "message": "Lambda code must not import frontend code (src/pages, src/hooks, src/api, src/lib/client)."
                  }
                ],
                "paths": {
                  "date-fns": {
                    "allowImportNames": ["Locale"],
                    "message": "Import date-fns by module path instead: date-fns/addDays. A bare specifier pulls the whole 245-export index into the module graph; when the lambdas resolved it from the dependencies layer that cost 508 ms of cold start against 8 ms for one module (KOE-6). Bundling (KOE-1330) now tree-shakes it away for the lambdas, but the module path stays the convention -- the frontend build has not been measured."
                  }
                }
              }
            }
          },
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {}
            }
          }
        }
      }
    },
    {
      "includes": ["src/lambda/lib/log.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off",
            "noRestrictedImports": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
