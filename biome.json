{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [{ "type": true }]
          }
        },
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "includes": ["src/**/*"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": "error"
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lambda/**", "src/lib/**", "src/i18n/**", "src/rules.ts", "src/rules_ch.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "date-fns": {
                    "allowImportNames": ["Locale"],
                    "message": "Import date-fns by module path instead: date-fns/addDays. The lambdas are bundled with packages: 'external', so a bare specifier is resolved from the dependencies layer at runtime and pulls in the whole 245-export index on every cold start -- 508 ms against 8 ms for one module. See KOE-6."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off",
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
